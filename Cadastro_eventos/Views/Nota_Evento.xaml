<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cadastro_eventos.Views.Nota_Evento"
             Title="Nota_Evento"
             NavigationPage.HasNavigationBar = "False"
             
BackgroundColor="{StaticResource Gray100}">
    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         Padding="65">
        <Label 
            Text="{Binding FestasSelecionada.Descricao}"
            FontFamily="Redaction10Bold"
            FontSize="50"
            TextColor="{StaticResource Gray600}"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
             />

        <Frame Margin="10">
            <StackLayout  Orientation="Horizontal" >
                <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                    <Label Text="Adultos: "  />
                    <Label Text="{Binding QuantidadeAdultos}" 
                           TextColor="{StaticResource Gray300}" />
                </HorizontalStackLayout>

                <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                    <Label Text="Crianças: " />
                    <Label Text="{Binding QuantidadeCriancas}" 
                           TextColor="{StaticResource Gray300}" />
                </HorizontalStackLayout>
            </StackLayout>
        </Frame>

        <Frame Margin="10">
            <Grid ColumnDefinitions="*, *, *"
                  RowDefinitions="Auto, Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Início:" />
                <Label Grid.Row="0" Grid.Column="1" Text="Termino:" />
                <Label Grid.Row="0" Grid.Column="2" Text="Duração:" />

                <Label Grid.Row="1" Grid.Column="0" 
                       Text="{Binding Inicio, StringFormat='{}{0:dd/MM/yyyy}'}"
                       TextColor="{StaticResource Gray300}" />

                <Label Grid.Row="1" Grid.Column="1" 
                       Text="{Binding Termino, StringFormat='{}{0:dd/MM/yyyy}'}"
                       TextColor="{StaticResource Gray300}" />

                <Label Grid.Row="1" Grid.Column="2" 
                       Text="{Binding Duracao, StringFormat='Dia(s): {0}'}"
                       TextColor="{StaticResource Gray300}"/>
            </Grid>
        </Frame>
        <Frame Margin="10">
        <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
            <Label Text="Valor Total: " />
            <Label Text="{Binding ValorTotal, StringFormat='{0:c}'} "
                       TextColor="{StaticResource Gray300}"/>
            </HorizontalStackLayout>
        </Frame>

        <Button Text="Voltar"
                HorizontalOptions="Center"
                Clicked="Button_Clicked" />

    </VerticalStackLayout>
</ContentPage>
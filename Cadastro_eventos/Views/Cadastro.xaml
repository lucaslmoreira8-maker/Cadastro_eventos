<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cadastro_eventos.Views.NewPage1"
             Title="NewPage1"
             NavigationPage.HasNavigationBar = "False"
             BackgroundColor="{StaticResource Gray100}">
    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         Padding="65">
        <Label 
            Text="Calculo de Eventos"
            FontFamily="Redaction10Bold"
            FontSize="50"
            TextColor="{StaticResource Gray600}"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
             />
        <Frame Padding="10">
            <VerticalStackLayout>
                <Label Text="Escolha sua Festa"/>

                <Picker x:Name="pck_festas"
                        ItemDisplayBinding="{Binding Descricao}"
                        SelectedIndexChanged="OnCampoAlterado"/>

                <Frame Padding="10" Margin="10">
                    <VerticalStackLayout>
                        <Label Text="Periódo de estadia"/>

                        <HorizontalStackLayout>
                            <Label Text="Data de Início"/>

                            <DatePicker x:Name="dtpck_checkin"
                                        DateSelected="dtpck_checkin_DateSelected"
                                        Format="dd/MM/yyyy"
                                        />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout>
                            <Label Text="Data de Termino"/>

                            <DatePicker x:Name="dtpck_check_out"
                                        
                                        Format="dd/MM/yyyy"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>
                
                <Label Text="Adultos"
                        TextColor="{StaticResource Gray100}"/>
                <Entry x:Name="AdultosEntry" 
                       Placeholder="Quantidade de Adultos"
                       TextChanged="OnCampoAlterado"/>
                <Label Text="Crianças"
                        TextColor="{StaticResource Gray100}"/>
                <Entry x:Name="CriancaEntry" 
                       Placeholder="Quantidade de crianças"
                       TextChanged="OnCampoAlterado"/>
                <Button x:Name="btn_avancar"
                        Text="Avançar"
                        IsEnabled="False"
                        Background="{StaticResource Gray400}"
                        Clicked="Button_Clicked"
                        />
            </VerticalStackLayout>
        </Frame>

    
    </VerticalStackLayout>
</ContentPage>